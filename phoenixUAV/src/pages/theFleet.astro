---
import BaseLayout from "../layouts/baseLayout.astro";
import PageHeader from "../components/pageHeader.astro";
import PageFooter from "../components/pageFooter.astro";
import FleetItem from "../components/fleetItem.astro";
import "../styles/theFleet.css";
---

<BaseLayout>
  <script type="module" src="https://ajax.googleapis.com/ajax/libs/model-viewer/4.0.0/model-viewer.min.js" is:inline></script>

  <PageHeader />

  <main class="fleet-container">
    <h1 class="fleet-title">Our Current and Past UAVs</h1>

    <div class="fleet-item-container">
      <FleetItem
        id="pax-2"
        name="PAX-2"
        modelSrc="/PAX-2.glb"
        description="Our 2025 Prototype UAV"
        specs={{
          wingspan: "1m",
          weight: "2kg",
          endurance: "20 mins",
          speed: "10 m/s",
          mission: "Prototype",
        }}
      >
        <p>
            PAX-2 is our first prototype aircraft made in 2025. It was made as a proof of concept to test design concepts 
            and to trial materials. The material choosen was foam due to the ease of manifacturing and low weight. 
        </p>
      </FleetItem>

    </div>
  </main>

  <PageFooter />
</BaseLayout>

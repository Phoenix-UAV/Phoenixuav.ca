---
import BaseLayout from "../layouts/baseLayout.astro";
import PageHeader from "../components/pageHeader.astro";
import PageFooter from "../components/pageFooter.astro";
import "../styles/photos.css";

// Import team photos from src/assets
import PlaneWing from "../assets/images/teamPhotos/PlaneWing.png";
import Brainstorm from "../assets/images/teamPhotos/Brainstorm.png";
import AeroImg from "../assets/images/teamPhotos/A&P.png";
import PlaneLogo from "../assets/images/teamPhotos/planes&logo.png";
import Structures from "../assets/images/teamPhotos/Stuctures 1.png";
import WingHeld from "../assets/images/teamPhotos/WingHeld 1.png";

const photoPageImages = Object.values(
  import.meta.glob("../../public/photo-page/*", {
    eager: true,
    query: "?url",
    import: "default",
  }),
) as string[];

const galleryImages = [
  PlaneWing.src,
  Brainstorm.src,
  WingHeld.src,
  "/photo-page/QV2A9565.JPG",
  "/photo-page/QV2A9570.JPG",
  AeroImg.src,
  "/photo-page/20260910_212436.jpg",
  "/photo-page/20260915_173823.jpg",
  "/photo-page/QV2A9574.JPG",
  Structures.src,
  "/photo-page/IMG_1106.jpg",
  "/photo-page/QV2A9576.JPG",
  PlaneLogo.src,
  "/photo-page/IMG_1849.jpg",
  "/photo-page/IMG_8295.jpg",
  ];

galleryImages.push(
  ...photoPageImages.filter((src) => !galleryImages.includes(src)),
);
---

<BaseLayout>
  <PageHeader />

  <main class="gallery-container">
    <div class="gallery-header">
      <h1 class="gallery-title">PHOTO GALLERY</h1>
    </div>

    <!-- Gallery Grid -->
    <div class="gallery-grid" id="galleryGrid">
      {
        galleryImages.map((src, index) => (
          <div
            class="gallery-card"
            data-index={index}
            data-src={src}
          >
            <div class="card-image-wrapper">
              <img src={src} alt="Phoenix Aerospace Gallery Photo" loading="lazy" />
            </div>
          </div>
        ))
      }
    </div>
  </main>

  <!-- Interactive Lightbox Modal -->
  <div class="lightbox-modal" id="lightboxModal">
    <button class="lightbox-close-btn" id="lightboxClose" aria-label="Close modal">&times;</button>
    
    <button class="lightbox-nav-btn lightbox-prev" id="lightboxPrev" aria-label="Previous image">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>
    
    <button class="lightbox-nav-btn lightbox-next" id="lightboxNext" aria-label="Next image">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>

    <div class="lightbox-content">
      <img id="lightboxImage" class="lightbox-image" src="" alt="Gallery Image" />
      <div class="lightbox-counter" id="lightboxCounter"></div>
    </div>
  </div>

  <script src="../scripts/photos.js"></script>

  <PageFooter />
</BaseLayout>

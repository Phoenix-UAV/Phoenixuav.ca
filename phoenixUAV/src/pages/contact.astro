---
import BaseLayout from "../layouts/baseLayout.astro";
import PageHeader from "../components/pageHeader.astro";
import Footer from "../components/pageFooter.astro";
import "../styles/contact.css";
---

<BaseLayout>
  <PageHeader />

  <main class="contact-page">
    <div class="contact-container">
      <!-- Left Column: Info & Socials -->
      <div class="contact-info">
        <div class="contact-title-group">
          <h1 class="contact-heading">GET IN TOUCH</h1>
          <p class="contact-subheading">WE'D LIKE TO HEAR FROM YOU!</p>
          <p class="contact-text">
            If you have any inquiries, sponsorship questions, or just want to say hi, please fill out the contact form below!
          </p>
        </div>

        <div class="contact-details-group">
          <!-- Email row with copy button -->
          <div class="contact-email-row">
            <svg class="contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="20" height="16" x="2" y="4" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
            <button type="button" id="copyEmailBtn" class="contact-email-copy-btn" title="Click to copy email address">
              <span class="email-address">contact@phoenixuav.ca</span>
              <span class="copy-badge" id="copyBadge">Copy</span>
            </button>
          </div>

          <!-- Socials row -->
          <div class="contact-socials-row">
            <!-- Instagram -->
            <a href="https://www.instagram.com/munphoenixaerospace/" target="_blank" rel="noopener noreferrer" class="social-icon-btn" title="Instagram">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
              </svg>
            </a>

            <!-- Notion -->
            <a href="https://phoenix-aerospace.notion.site" target="_blank" rel="noopener noreferrer" class="social-icon-btn" title="Notion">
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M4.459 4.208c.746.606 1.026.56 2.428.466l13.215-.793c.28 0 .047-.28-.047-.326L17.86 1.637c-.42-.326-.98-.466-1.54-.373L3.712 2.943c-.466.093-.7.373-.7.746v15.86c0 .42.233.7.746.98l13.915 8.163c.42.233.933.28 1.353.047l4.06-2.333c.373-.233.42-.513.42-.793V9.712c0-.42-.14-.653-.513-.7l-2.053-.28c-.373-.047-.56.14-.56.513v12.27l-10.9-6.39V5.513l8.633-.513v6.39c0 .42.187.653.56.7l2.053.28c.373.047.513-.187.513-.56V4.488c0-.42-.233-.653-.7-.793L4.459 4.208z"/>
              </svg>
            </a>

            <!-- LinkedIn -->
            <a href="https://www.linkedin.com/company/phoenix-aerospace" target="_blank" rel="noopener noreferrer" class="social-icon-btn" title="LinkedIn">
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/>
              </svg>
            </a>

            <!-- Copy Email Icon Button -->
            <button type="button" class="social-icon-btn" id="socialCopyEmailBtn" title="Copy Email Address">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
              </svg>
            </button>
          </div>
        </div>
      </div>

      <!-- Right Column: Contact Form -->
      <div class="contact-form-container">
        <form class="contact-form" id="contactForm">
          <div class="form-row-double">
            <div class="form-group">
              <label for="firstName" class="form-label">First Name</label>
              <input type="text" id="firstName" name="firstName" class="form-input" placeholder="John" autocomplete="given-name" />
            </div>

            <div class="form-group">
              <label for="lastName" class="form-label">Last Name</label>
              <input type="text" id="lastName" name="lastName" class="form-input" placeholder="Doe" autocomplete="family-name" />
            </div>
          </div>

          <div class="form-group">
            <label for="email" class="form-label">Email *</label>
            <input type="email" id="email" name="email" class="form-input" placeholder="john@example.com" required autocomplete="email" />
          </div>

          <div class="form-group">
            <label for="message" class="form-label">Message *</label>
            <textarea id="message" name="message" class="form-textarea" placeholder="How can we help you?" rows="5" required></textarea>
          </div>

          <div class="form-submit-row">
            <button type="submit" class="submit-btn" id="submitBtn">Send Message</button>
          </div>

          <div id="formStatus" class="form-status"></div>
        </form>
      </div>
    </div>
  </main>

  <Footer />

  <script src="../scripts/contact.js"></script>
</BaseLayout>



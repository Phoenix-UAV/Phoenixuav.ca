---
import BaseLayout from "../layouts/baseLayout.astro";
import PageHeader from "../components/pageHeader.astro";
import PageFooter from "../components/pageFooter.astro";
import { subteamMembers } from "../data/teamMembers.js";
import "../styles/about.css";
---

<BaseLayout>
  <PageHeader />
  <main class="Container">
    <section class="aboutHero">
      <h1>About Us</h1>
    </section>

    <section class="whoWeAre">
      <div class="description">
        <p class="descriptionText">
          We are a student design team at Memorial University of Newfoundland, designing a fixed-wing drone to compete in the IMechE UAV Challenge. Our team is made up of students from a variety of disciplines, including mechanical engineering, mechatronics engineering, electrical engineering, computer engineering, computer science, and business. We consist of four sub-teams: Structures, Electrical, Software, Aerodynamics & Propulsion, and Outreach & Administration.
        </p>
      </div>
    </section>

    <!-- Full-Width Grey Strip Section breaking up the black page -->
    <section class="greyStripSection">
      <div class="subteamsContainer">
        <div class="subteamsSidebar">
          <h2 class="subteamsTitle">OUR SUB TEAMS</h2>
          <div class="subteamsNav">
            <button class="subteamTab active" data-target="aero">AERO & PROP</button>
            <button class="subteamTab" data-target="business">BUSINESS</button>
            <button class="subteamTab" data-target="electrical">ELECTRICAL</button>
            <button class="subteamTab" data-target="software">SOFTWARE</button>
            <button class="subteamTab" data-target="structures">STRUCTURES</button>
          </div>
        </div>

        <div class="subteamsDisplay">
          <div class="subteamPanel active" id="panel-aero">
            <div class="panelText">
              <p>The Aerodynamics & Propulsion sub-team is responsible for the flight
                performance, stability, and power systems of the aircraft. This team
                handles the theoretical and electrical reality of the vehicle — ensuring
                the aircraft generates enough lift to fly, remains stable in the air,
                and has a reliable power system to sustain flight.</p>
            </div>
          </div>

          <div class="subteamPanel" id="panel-business">
            <div class="panelText">
              <p>The Outreach & Administration sub-team is responsible for the
                organizational backbone, financial health, and public presence of the
                team. This team handles the logistical and operational reality of the
                project — managing team structure, securing funding, ensuring competition
                compliance, and building a professional brand identity that connects the
                team with sponsors and the community.</p>
            </div>
          </div>

          <div class="subteamPanel" id="panel-electrical">
            <div class="panelText">
              <p>The Electrical sub-team is responsible for the design, integration, and 
              management of the aircraft’s onboard power and avionics systems. This team 
              handles the choice of electrical components and making sure the aircraft can 
              meet both the endurance requirements and the capability requirements set by 
              the other teams.</p>
            </div>
          </div>

          <div class="subteamPanel" id="panel-software">
            <div class="panelText">
              <p>The Software sub-team is responsible for the intelligence, control,
               and operational command of the aircraft. This team handles the digital and behavioral 
               reality of the vehicle — ensuring the aircraft can safely communicate with the ground, 
               execute precise flight paths, and seamlessly transition between manual piloting and fully 
               autonomous flight.</p>
            </div>
          </div>

          <div class="subteamPanel" id="panel-structures">
            <div class="panelText">
              <p>The Structures sub-team is responsible for the physical design,
                analysis, and fabrication of the aircraft. This team handles the
                physical reality of the vehicle — ensuring it is lightweight enough to
                fly, strong enough to survive flight forces, and capable of being built
                within a student workshop.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- TEAM MEMBERS Section -->
    <section class="ourTeamSection">
      <div class="teamContainer">
        <h2 class="teamTitle">MEET THE TEAM</h2>

        {subteamMembers.map((group) => {
          if (group.subteam === "Advisors" && group.members.length === 0) return null;
          return (
            <div class="subteamGroup">
              <h3 class="subteamGroupTitle">{group.subteam}</h3>
              {group.members.length > 0 ? (
                <div class="teamGrid">
                  {group.members.map((member) => (
                    <div class="teamMemberCard">
                      <div class="memberPhotoContainer">
                        <img src={member.image || "/Team-members/Profile_placeholder.png"} alt={member.name} class="memberPhoto" />
                      </div>
                      <h4 class="memberName">{member.name}</h4>
                      <p class="memberRole">{member.role}</p>
                      
                      <div class="memberSocials">
                        {member.linkedin && (
                          <a href={member.linkedin} target="_blank" rel="noopener noreferrer" class="socialBtn" aria-label={`${member.name}'s LinkedIn`}>
                            <svg class="socialIcon" viewBox="0 0 24 24" fill="currentColor">
                              <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/>
                            </svg>
                          </a>
                        )}
                        {member.github && (
                          <a href={member.github} target="_blank" rel="noopener noreferrer" class="socialBtn" aria-label={`${member.name}'s GitHub`}>
                            <svg class="socialIcon" viewBox="0 0 24 24" fill="currentColor">
                              <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                            </svg>
                          </a>
                        )}
                        {member.email && (
                          <button
                            type="button"
                            class="socialBtn copyEmailBtn"
                            data-email={member.email}
                            aria-label={`Copy email address of ${member.name}`}
                            title={`Click to copy ${member.email}`}
                          >
                            <svg class="socialIcon" viewBox="0 0 24 24" fill="currentColor">
                              <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
                            </svg>
                          </button>
                        )}
                        {member.website && (
                          <a href={member.website} target="_blank" rel="noopener noreferrer" class="socialBtn" aria-label={`${member.name}'s Website`}>
                            <svg class="socialIcon" viewBox="0 0 24 24" fill="currentColor">
                              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/>
                            </svg>
                          </a>
                        )}
                      </div>
                    </div>
                  ))}
                </div>
              ) : (
                <div class="empty-subteam-card">
                  <span>Interested in joining?</span>
                  <a href="/contact">Contact Us &rarr;</a>
                </div>
              )}
            </div>
          );
        })}
      </div>
    </section>
  </main>

  <script src="../scripts/subteams.js"></script>
  <script src="../scripts/emailCopy.js"></script>
  <PageFooter />
</BaseLayout>

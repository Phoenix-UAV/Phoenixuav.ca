---
import BaseLayout from "../layouts/baseLayout.astro";
import PageHeader from "../components/pageHeader.astro";
import Footer from "../components/pageFooter.astro";
import { diamondSponsors, goldSponsors, silverSponsors, bronzeSponsors } from "../data/sponsors.js";
import "../styles/sponsors.css";
const PACKAGE = "/PACKAGE.pdf";

interface Sponsor {
  name: string;
  logo: string;
  url?: string;
  website?: string;
  class?: string;
}
---

<BaseLayout>
  <PageHeader />

  <main>
    <section class="SponsorshipHead">
      <h1 class="SponsorQuestion">WHY SPONSOR PHOENIX AEROSPACE?</h1>
    </section>
    <section>
      <div>
        <p class="SponsorText">
          Phoenix Aerospace provides students the chance to dive head-first into
          robotics, engineering, and aerodynamics. As a sponsor, you will make
          this hands-on learning possible, while gaining brand exposure at
          national events. Take a look at our sponsorship package below to
          discover different ways you can get involved!
        </p>
      </div>
    </section>

    <!-- Diamond Sponsors Section -->
    <section class="sponsorStripSection diamondTierSection">
      <div class="sponsorStripContainer">
        <h2 class="sponsorStripTitle">OUR DIAMOND SPONSORS</h2>
        {diamondSponsors.length > 0 ? (
          <div class="sponsorLogosGrid">
            {diamondSponsors.map((sponsor: Sponsor) => {
              const link = sponsor.url || sponsor.website;
              return link ? (
                <a
                  href={link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="sponsorLogoCard sponsorLogoLink"
                  title={`Visit ${sponsor.name}'s website`}
                  aria-label={`Visit ${sponsor.name}'s website (opens in a new tab)`}
                >
                  <img src={sponsor.logo} alt={sponsor.name} class={`sponsorLogoImg ${sponsor.class || ''}`.trim()} />
                </a>
              ) : (
                <div class="sponsorLogoCard">
                  <img src={sponsor.logo} alt={sponsor.name} class={`sponsorLogoImg ${sponsor.class || ''}`.trim()} />
                </div>
              );
            })}
          </div>
        ) : (
          <div class="empty-tier-card">
            <span>SPONSORSHIP OPPORTUNITIES AVAILABLE</span>
            <a href="/contact">Become a Diamond Sponsor &rarr;</a>
          </div>
        )}
      </div>
    </section>

    <!-- Gold Sponsors Section -->
    <section class="sponsorStripSection goldTierSection">
      <div class="sponsorStripContainer">
        <h2 class="sponsorStripTitle">OUR GOLD SPONSORS</h2>
        {goldSponsors.length > 0 ? (
          <div class="sponsorLogosGrid">
            {goldSponsors.map((sponsor: Sponsor) => {
              const link = sponsor.url || sponsor.website;
              return link ? (
                <a
                  href={link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="sponsorLogoCard sponsorLogoLink"
                  title={`Visit ${sponsor.name}'s website`}
                  aria-label={`Visit ${sponsor.name}'s website (opens in a new tab)`}
                >
                  <img src={sponsor.logo} alt={sponsor.name} class={`sponsorLogoImg ${sponsor.class || ''}`.trim()} />
                </a>
              ) : (
                <div class="sponsorLogoCard">
                  <img src={sponsor.logo} alt={sponsor.name} class={`sponsorLogoImg ${sponsor.class || ''}`.trim()} />
                </div>
              );
            })}
          </div>
        ) : (
          <div class="empty-tier-card">
            <span>SPONSORSHIP OPPORTUNITIES AVAILABLE</span>
            <a href="/contact">Become a Gold Sponsor &rarr;</a>
          </div>
        )}
      </div>
    </section>

    <!-- Silver Sponsors Section -->
    <section class="sponsorStripSection silverTierSection">
      <div class="sponsorStripContainer">
        <h2 class="sponsorStripTitle">OUR SILVER SPONSORS</h2>
        {silverSponsors.length > 0 ? (
          <div class="sponsorLogosGrid">
            {silverSponsors.map((sponsor: Sponsor) => {
              const link = sponsor.url || sponsor.website;
              return link ? (
                <a
                  href={link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="sponsorLogoCard sponsorLogoLink"
                  title={`Visit ${sponsor.name}'s website`}
                  aria-label={`Visit ${sponsor.name}'s website (opens in a new tab)`}
                >
                  <img src={sponsor.logo} alt={sponsor.name} class={`sponsorLogoImg ${sponsor.class || ''}`.trim()} />
                </a>
              ) : (
                <div class="sponsorLogoCard">
                  <img src={sponsor.logo} alt={sponsor.name} class={`sponsorLogoImg ${sponsor.class || ''}`.trim()} />
                </div>
              );
            })}
          </div>
        ) : (
          <div class="empty-tier-card">
            <span>SPONSORSHIP OPPORTUNITIES AVAILABLE</span>
            <a href="/contact">Become a Silver Sponsor &rarr;</a>
          </div>
        )}
      </div>
    </section>

    <!-- Bronze Sponsors Section -->
    <section class="sponsorStripSection bronzeTierSection">
      <div class="sponsorStripContainer">
        <h2 class="sponsorStripTitle">OUR BRONZE SPONSORS</h2>
        {bronzeSponsors.length > 0 ? (
          <div class="sponsorLogosGrid">
            {bronzeSponsors.map((sponsor: Sponsor) => {
              const link = sponsor.url || sponsor.website;
              return link ? (
                <a
                  href={link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="sponsorLogoCard sponsorLogoLink"
                  title={`Visit ${sponsor.name}'s website`}
                  aria-label={`Visit ${sponsor.name}'s website (opens in a new tab)`}
                >
                  <img src={sponsor.logo} alt={sponsor.name} class={`sponsorLogoImg ${sponsor.class || ''}`.trim()} />
                </a>
              ) : (
                <div class="sponsorLogoCard">
                  <img src={sponsor.logo} alt={sponsor.name} class={`sponsorLogoImg ${sponsor.class || ''}`.trim()} />
                </div>
              );
            })}
          </div>
        ) : (
          <div class="empty-tier-card">
            <span>SPONSORSHIP OPPORTUNITIES AVAILABLE</span>
            <a href="/contact">Become a Bronze Sponsor &rarr;</a>
          </div>
        )}
      </div>
    </section>

    <section class="pdfHeaderSection">
      <h2 class="pdfSectionTitle">SPONSORSHIP PACKAGE</h2>
    </section>
  </main>
  <div class="imageContainer">
    <iframe src={PACKAGE} width="80%" height="1200px" allow="autoplay"> </iframe>
  </div>
  <div class="pdfMobileCTA">
    <a href={PACKAGE} class="downloadButton" target="_blank">
      DOWNLOAD SPONSORSHIP PACKAGE (PDF)
    </a>
  </div>
  <Footer />
</BaseLayout>

---
interface Props {
  id: string;
  name: string;
  modelSrc: string;
  description: string;
  reversed?: boolean;
  specs?: {
    wingspan?: string;
    weight?: string;
    endurance?: string;
    speed?: string;
    mission?: string;
    propulsion?: string;
  };
}

const { id, name, modelSrc, description, reversed = false, specs } = Astro.props;
const hasSpecs = !!specs && Object.values(specs).some(val => val);
---

<section id={id} class="fleet-section">
  <div class={`description ${reversed ? 'reversed' : ''}`}>
    <model-viewer
      src={modelSrc}
      alt={`3D Model of the ${name} UAV`}
      camera-controls
      auto-rotate
      interaction-prompt="none"
      shadow-intensity="1"
      touch-action="pan-y"
    >
    </model-viewer>

    <div class="descriptionText">
      <h2 class="uav-name">{name}</h2>
      <p class="uav-description">{description}</p>
      <div class="uav-divider"></div>
      {hasSpecs && (
        <div class="uav-specs-columns">
          <div class="uav-spec-col">
            <h3 class="spec-col-title">Flight Performance</h3>
            <ul class="spec-list">
              {specs.wingspan && (
                <li>
                  <span class="spec-icon">+</span>
                  <span class="spec-label">WINGSPAN:</span>
                  <span class="spec-value">{specs.wingspan}</span>
                </li>
              )}

              {specs.weight && (
                <li>
                  <span class="spec-icon">+</span>
                  <span class="spec-label">WEIGHT:</span>
                  <span class="spec-value">{specs.weight}</span>
                </li>
              )}

              {specs.endurance && (
                <li>
                  <span class="spec-icon">+</span>
                  <span class="spec-label">ENDURANCE:</span>
                  <span class="spec-value">{specs.endurance}</span>
                </li>
              )}
            </ul>
          </div>
          
          <div class="uav-spec-col">
            <h3 class="spec-col-title">System Details</h3>
            <ul class="spec-list">
              {specs.speed && (
                <li>
                  <span class="spec-icon">+</span>
                  <span class="spec-label">SPEED:</span>
                  <span class="spec-value">{specs.speed}</span>
                </li>
              )}

              {specs.mission && (
                <li>
                  <span class="spec-icon">+</span>
                  <span class="spec-label">MISSION:</span>
                  <span class="spec-value">{specs.mission}</span>
                </li>
              )}

              {specs.propulsion && (
                <li>
                  <span class="spec-icon">+</span>
                  <span class="spec-label">PROPULSION:</span>
                  <span class="spec-value">{specs.propulsion}</span>
                </li>
              )}
            </ul>
          </div>
        </div>
      )}
    </div>
  </div>

  <div class="uav-extra-content">
    <slot />
  </div>
</section>
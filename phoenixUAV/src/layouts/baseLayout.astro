---
import "../styles/index.css";
import "../styles/global.css";
import { Font } from "astro:assets";
import PageHeader from "../components/pageHeader.astro";
import PageFooter from "../components/pageFooter.astro";
---

<!-- components -> layouts -> layouts onto pages -->
<html lang="en">
  <head>
    <Font cssVariable="--bank-gothic-bold" preload />
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/phoenix.svg" />
    <link rel="icon" href="/phoenix.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Phoenix Aerospace</title>
  </head>
  <body>
    <PageHeader />
    <main>
      <h1>This Is Main Content</h1>
    </main>

    <section>
      <h1>This Is Section Content</h1>
    </section>
    <PageFooter />
  </body>
</html>
